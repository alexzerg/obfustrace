# Server-only Nutrient Document Web Services credential.
# Obtain it from the Nutrient dashboard and never commit a real value.
NUTRIENT_DWS_API_KEY=

# Doctavian Documents credentials. The access token is short-lived.
# Obtain both values from the Doctavian Portal API Keys page.
DOCTAVIAN_DOCUMENTS_API_KEY=
DOCTAVIAN_ACCESS_TOKEN=
